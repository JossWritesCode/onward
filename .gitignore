# Secrets and local settings: never commit these
backend/.env
backend/config/master.key
*.local

# Rails
backend/.bundle/
backend/vendor/bundle/
backend/log/*
!backend/log/.keep
backend/tmp/*
!backend/tmp/.keep
backend/storage/

# Frontend
frontend/node_modules/
# The built app, made by `npm run build` (Render builds it on deploy)
backend/public/
frontend/dist/
# Generated by `npm run codegen` from backend/schema.graphql
frontend/src/gql/

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
