#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Installing gems =="
  system("bundle check") || system!("bundle install")

  unless File.exist?(".env")
    puts "\n== Creating .env from .env.example =="
    FileUtils.cp ".env.example", ".env"
  end

  env = File.read(".env")
  unless env.match?(/^ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=\S/)
    puts "\n== Generating encryption keys in .env =="
    require "securerandom"
    File.open(".env", "a") do |file|
      file.puts
      file.puts "# Encrypts secrets like your GitHub token. Keep these private, and don't change"
      file.puts "# them later, or saved secrets can't be read anymore."
      file.puts "ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=#{SecureRandom.alphanumeric(32)}"
      file.puts "ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=#{SecureRandom.alphanumeric(32)}"
      file.puts "ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=#{SecureRandom.alphanumeric(32)}"
    end
  end

  puts "\n== Preparing the database =="
  system! "bin/rails db:prepare"

  puts "\n== Writing the GraphQL schema for the frontend =="
  system! "bin/rails graphql:dump_schema"

  puts "\n== Done. Start the API with: bin/rails server =="
end
